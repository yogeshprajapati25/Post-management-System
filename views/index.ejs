<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PostHub - Share Your Thoughts</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-[#0f0f0f] text-white">
    <%- include('partials/nav') %>
    
    <div class="min-h-screen flex items-center justify-center p-6">
        <div class="text-center max-w-2xl">
            <div class="mb-6">
                <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-[#3ea6ff] flex items-center justify-center text-4xl font-bold">P</div>
                <h1 class="text-5xl font-bold mb-4">Welcome to PostHub</h1>
                <p class="text-xl text-[#aaa] mb-8">Share your thoughts, connect with others, and explore amazing content</p>
            </div>
            
            <div class="flex gap-4 justify-center">
                <a href="/signup" class="btn-primary px-8 py-3 text-lg">Get Started</a>
                <a href="/login" class="btn-secondary px-8 py-3 text-lg">Login</a>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16">
                <div class="card text-center">
                    <div class="text-3xl mb-3">📝</div>
                    <h3 class="font-semibold mb-2">Create Posts</h3>
                    <p class="text-sm text-[#aaa]">Share your thoughts with images and text</p>
                </div>
                <div class="card text-center">
                    <div class="text-3xl mb-3">💬</div>
                    <h3 class="font-semibold mb-2">Engage</h3>
                    <p class="text-sm text-[#aaa]">Comment, like, and discuss with the community</p>
                </div>
                <div class="card text-center">
                    <div class="text-3xl mb-3">🚀</div>
                    <h3 class="font-semibold mb-2">Grow</h3>
                    <p class="text-sm text-[#aaa]">Build your profile and connect with others</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
