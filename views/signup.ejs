<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up — PostHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0f172a] text-slate-100 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <!-- Brand -->
        <div class="flex items-center justify-center gap-2 mb-8">
            <span class="w-9 h-9 rounded-xl bg-indigo-500 flex items-center justify-center text-white font-bold text-lg">P</span>
            <span class="text-xl font-bold tracking-tight">PostHub</span>
        </div>

        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-7">
            <h1 class="text-xl font-bold mb-1">Create account</h1>
            <p class="text-sm text-slate-400 mb-6">Join PostHub today</p>

            <form action="/register" method="post" class="flex flex-col gap-4" id="signupForm">
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="name">Full Name</label>
                    <input id="name" type="text" name="name" placeholder="John Doe" required autocomplete="name"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="username">Username</label>
                    <input id="username" type="text" name="username" placeholder="johndoe" required autocomplete="username"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="email">Email address</label>
                    <input id="email" type="email" name="email" placeholder="you@example.com" required autocomplete="email"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="age">Age</label>
                    <input id="age" type="number" name="age" placeholder="18" min="13" required
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                    <p class="text-xs text-slate-600 mt-1">Must be 13 or older</p>
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="password">Password</label>
                    <input id="password" type="password" name="password" placeholder="Min 6 characters" minlength="6" required autocomplete="new-password"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="confirmPassword">Confirm Password</label>
                    <input id="confirmPassword" type="password" name="confirmPassword" placeholder="••••••••" minlength="6" required autocomplete="new-password"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                    <p class="text-xs mt-1 h-4" id="confirmHint"></p>
                </div>
                <button type="submit"
                    class="w-full mt-1 py-2.5 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-sm font-semibold text-white transition">
                    Create Account
                </button>
            </form>

            <p class="mt-5 text-center text-sm text-slate-500">
                Already have an account?
                <a href="/login" class="text-indigo-400 hover:text-indigo-300">Login</a>
            </p>
        </div>
    </div>

    <script>
        const pwd = document.getElementById('password');
        const confirm = document.getElementById('confirmPassword');
        const hint = document.getElementById('confirmHint');
        function check() {
            if (!confirm.value) { hint.textContent = ''; return; }
            if (pwd.value !== confirm.value) {
                hint.textContent = 'Passwords do not match';
                hint.style.color = '#f87171';
            } else {
                hint.textContent = 'Passwords match ✓';
                hint.style.color = '#34d399';
            }
        }
        confirm.addEventListener('input', check);
        pwd.addEventListener('input', check);
        document.getElementById('signupForm').addEventListener('submit', e => {
            if (pwd.value !== confirm.value) { e.preventDefault(); }
        });
    </script>
</body>
</html>
