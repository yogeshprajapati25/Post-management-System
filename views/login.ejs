<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-3xl mb-5">Login Your Account</h3>
        <% if (typeof exists !== 'undefined' && exists) { %>
            <p class="mb-3 text-amber-400">Account already exists. Please log in.</p>
        <% } %>
        <% if (typeof registered !== 'undefined' && registered) { %>
            <p class="mb-3 text-green-400">Account created. Please log in.</p>
        <% } %>
        <form action="/login" method="post">
            <input class="px-3 py-2 outline-none bg-transparent rounded-md border-2 border-zinc-800" type="email" placeholder="email" name="email" required>
            <input class="px-3 py-2 outline-none bg-transparent rounded-md border-2 border-zinc-800" type="password" placeholder="password" name="password" required>
            
            <input class="px-5 py-2 bg-blue-500 rounded-md" type="submit" value="Login Account">
            
            
        </form>
    </div>
</body>
</html>
