<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — PostHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0f172a] text-slate-100 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <!-- Brand -->
        <div class="flex items-center justify-center gap-2 mb-8">
            <span class="w-9 h-9 rounded-xl bg-indigo-500 flex items-center justify-center text-white font-bold text-lg">P</span>
            <span class="text-xl font-bold tracking-tight">PostHub</span>
        </div>

        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-7">
            <h1 class="text-xl font-bold mb-1">Welcome back</h1>
            <p class="text-sm text-slate-400 mb-6">Login to your account</p>

            <% if (typeof exists !== 'undefined' && exists) { %>
            <div class="mb-4 px-3 py-2 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400 text-sm">
                Account already exists. Please log in.
            </div>
            <% } %>
            <% if (typeof registered !== 'undefined' && registered) { %>
            <div class="mb-4 px-3 py-2 bg-green-500/10 border border-green-500/30 rounded-xl text-green-400 text-sm">
                Account created! Please log in.
            </div>
            <% } %>

            <form action="/login" method="post" class="flex flex-col gap-4">
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="email">Email address</label>
                    <input id="email" type="email" name="email" placeholder="you@example.com" required autocomplete="email"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1.5" for="password">Password</label>
                    <input id="password" type="password" name="password" placeholder="••••••••" required autocomplete="current-password"
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition placeholder-slate-600">
                </div>
                <button type="submit"
                    class="w-full mt-1 py-2.5 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-sm font-semibold text-white transition">
                    Login
                </button>
            </form>

            <p class="mt-5 text-center text-sm text-slate-500">
                Don't have an account?
                <a href="/signup" class="text-indigo-400 hover:text-indigo-300">Sign up</a>
            </p>
        </div>
    </div>
</body>
</html>
