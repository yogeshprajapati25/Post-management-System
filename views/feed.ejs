<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-between items-center mb-5">
            <h2 class="text-2xl font-semibold">All Posts</h2>
            <div class="flex gap-3">
                <a class="bg-zinc-700 rounded-md px-3 py-2 text-sm inline-block" href="/profile">Your Posts</a>
                <a class="bg-red-500 rounded-md px-3 py-2 text-sm inline-block" href="/logout">Logout</a>
            </div>
        </div>

        <div class="postcontainer mt-5 flex flex-col gap-4">
            <% posts.forEach(function(post){ %>
                <div class="post w-1/3 p-4 rounded-md border-[1px] border-zinc-700">
                    <h4 class="text-blue-500 mb-2">@<%= post.user && post.user.username ? post.user.username : 'unknown' %></h4>
                    <p class="text-sm tracking-tight"><%= post.content %></p>
                    <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
                    <div class="btns flex gap-4 mt-1 items-center">
                        <a class="text-blue-500" href="/like/<%= post._id %>?from=feed">
                            <%= post.likes.indexOf(currentUserId) === -1 ? "Like" : "UnLike" %>
                        </a>
                                <button type="button" class="text-green-400 comment-toggle" data-post-id="<%= post._id %>">Comment</button>
                    </div>
                            <div class="comments mt-3">
                                <div class="existing-comments mb-2">
                                    <% if (post.comments && post.comments.length) { %>
                                        <% post.comments.forEach(function(c){ %>
                                            <div class="comment p-2 rounded-md bg-zinc-800 mb-2 flex justify-between items-start">
                                                <div>
                                                    <strong class="text-blue-400">@<%= c.user && c.user.username ? c.user.username : 'unknown' %></strong>
                                                    <p class="text-sm"><%= c.content %></p>
                                                </div>
                                                <div class="comment-actions text-sm">
                                                    <% if (c.user && c.user._id.toString() === currentUserId.toString()) { %>
                                                        <div>
                                                            <form action="/comment/<%= post._id %>/edit/<%= c._id %>" method="post" style="display:inline">
                                                                <button type="button" class="edit-comment-btn text-yellow-400" data-post-id="<%= post._id %>" data-comment-id="<%= c._id %>">Edit</button>
                                                            </form>
                                                            <form action="/comment/<%= post._id %>/delete/<%= c._id %>" method="post" style="display:inline">
                                                                <button type="submit" class="text-red-400">Delete</button>
                                                            </form>
                                                        </div>
                                                    <% } else if (post.user && post.user._id.toString() === currentUserId.toString()) { %>
                                                        <form action="/comment/<%= post._id %>/delete/<%= c._id %>" method="post" style="display:inline">
                                                            <button type="submit" class="text-red-400">Delete</button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                                <div class="add-comment hidden" id="add-<%= post._id %>">
                                    <form action="/comment/<%= post._id %>" method="post" class="flex gap-2">
                                        <input name="content" placeholder="Write a comment..." class="flex-1 px-2 py-1 rounded-md text-black" required />
                                        <button type="submit" class="px-3 py-1 bg-blue-500 rounded-md">Post</button>
                                    </form>
                                </div>
                            </div>
                </div>
            <% }) %>
        </div>
    <script>
        document.querySelectorAll('.comment-toggle').forEach(btn => {
            btn.addEventListener('click', e => {
                const postId = btn.getAttribute('data-post-id');
                const el = document.getElementById('add-' + postId);
                if (el) el.classList.toggle('hidden');
            })
        });

        // edit buttons: toggle an inline edit form
        document.querySelectorAll('.edit-comment-btn').forEach(btn => {
            btn.addEventListener('click', e => {
                const postId = btn.getAttribute('data-post-id');
                const commentId = btn.getAttribute('data-comment-id');
                const commentEl = btn.closest('.comment');
                if (!commentEl) return;
                const contentP = commentEl.querySelector('p');
                const old = contentP ? contentP.textContent : '';
                // create edit form
                const form = document.createElement('form');
                form.method = 'post';
                form.action = `/comment/${postId}/edit/${commentId}`;
                form.className = 'flex gap-2';
                const input = document.createElement('input');
                input.name = 'content';
                input.value = old;
                input.className = 'flex-1 px-2 py-1 rounded-md text-black';
                const save = document.createElement('button');
                save.type = 'submit';
                save.className = 'px-3 py-1 bg-green-500 rounded-md';
                save.textContent = 'Save';
                const cancel = document.createElement('button');
                cancel.type = 'button';
                cancel.className = 'px-3 py-1 bg-zinc-700 rounded-md';
                cancel.textContent = 'Cancel';
                cancel.addEventListener('click', () => {
                    // restore original
                    commentEl.querySelector('div').style.display = '';
                    form.remove();
                });
                commentEl.querySelector('div').style.display = 'none';
                form.appendChild(input);
                form.appendChild(save);
                form.appendChild(cancel);
                commentEl.appendChild(form);
            });
        });
    </script>
    </div>
</body>
</html>

