<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed — PostHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0f172a] text-slate-100 min-h-screen">

    <!-- Nav -->
    <nav class="sticky top-0 z-30 bg-[#0f172a]/90 backdrop-blur border-b border-slate-800">
        <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
            <a href="/feed" class="font-bold text-lg tracking-tight flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-500 flex items-center justify-center text-white text-sm font-bold">P</span>
                PostHub
            </a>
            <div class="flex items-center gap-1 text-sm">
                <a href="/feed" class="px-3 py-1.5 rounded-lg bg-slate-800 text-white font-medium">Feed</a>
                <a href="/profile" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Profile</a>
                <a href="/logout" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Logout</a>
            </div>
        </div>
    </nav>

    <div class="max-w-2xl mx-auto px-4 py-8">
        <%
        function timeAgo(d) {
            if (!d) return '';
            var s = Math.floor((Date.now() - new Date(d).getTime()) / 1000);
            if (s < 60) return 'just now';
            var m = Math.floor(s / 60); if (m < 60) return m + (m === 1 ? ' minute ago' : ' minutes ago');
            var h = Math.floor(m / 60); if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
            var dy = Math.floor(h / 24); if (dy < 30) return dy + (dy === 1 ? ' day ago' : ' days ago');
            var mo = Math.floor(dy / 30); if (mo < 12) return mo + (mo === 1 ? ' month ago' : ' months ago');
            var y = Math.floor(mo / 12); return y + (y === 1 ? ' year ago' : ' years ago');
        }
        function likedByMe(likes, uid) {
            return (likes || []).some(function(id){ return id.toString() === uid.toString(); });
        }
        function childCount(comments, parentId) {
            var pid = parentId ? parentId.toString() : null;
            return (comments || []).filter(function(c) {
                var p = c.parent ? c.parent.toString() : null;
                return p === pid;
            }).length;
        }
        %>

        <div class="flex flex-col gap-4">
            <% posts.forEach(function(post){
                var topCount = childCount(post.comments, null);
                var liked = likedByMe(post.likes, currentUserId);
                var disliked = likedByMe(post.dislikes || [], currentUserId);
                var uname = post.user && post.user.username ? post.user.username : 'unknown';
            %>
            <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-5">
                <!-- Post header -->
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-9 h-9 rounded-full bg-indigo-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                        <%= uname.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-white">@<%= uname %></p>
                        <p class="text-xs text-slate-400"><%= timeAgo(post.date) %></p>
                    </div>
                </div>

                <!-- Post content -->
                <p class="text-sm text-slate-200 leading-relaxed mb-4"><%= post.content %></p>

                <!-- Reactions -->
                <div class="flex items-center gap-1 mb-4">
                    <!-- Like -->
                    <a href="/like/<%= post._id %>?from=feed"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm transition
                            <%= liked ? 'bg-indigo-500/20 text-indigo-400' : 'hover:bg-slate-700 text-slate-400' %>">
                        <% if (liked) { %>
                        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M2 20h2c.55 0 1-.45 1-1v-9c0-.55-.45-1-1-1H2v11zm19.83-7.12c.11-.25.17-.52.17-.8V11c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66-.23-.45-.52-.86-.88-1.22L14 2 7.59 8.41C7.21 8.79 7 9.3 7 9.83V19c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3-7.12z"/></svg>
                        <% } else { %>
                        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M14 2l-1.41 1.41L14.17 5H11c-1.1 0-1.99.9-1.99 2L9 18c0 1.1.89 2 1.99 2H18c.83 0 1.54-.5 1.84-1.22l3-7.12c.11-.25.17-.52.17-.8V10c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66L16 2h-2zM4 20H2V9h2v11z"/></svg>
                        <% } %>
                        <span><%= post.likes.length || '' %></span>
                    </a>
                    <!-- Dislike -->
                    <a href="/dislike/<%= post._id %>?from=feed"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm transition
                            <%= disliked ? 'bg-rose-500/20 text-rose-400' : 'hover:bg-slate-700 text-slate-400' %>">
                        <% if (disliked) { %>
                        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current rotate-180"><path d="M2 20h2c.55 0 1-.45 1-1v-9c0-.55-.45-1-1-1H2v11zm19.83-7.12c.11-.25.17-.52.17-.8V11c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66-.23-.45-.52-.86-.88-1.22L14 2 7.59 8.41C7.21 8.79 7 9.3 7 9.83V19c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3-7.12z"/></svg>
                        <% } else { %>
                        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current rotate-180"><path d="M14 2l-1.41 1.41L14.17 5H11c-1.1 0-1.99.9-1.99 2L9 18c0 1.1.89 2 1.99 2H18c.83 0 1.54-.5 1.84-1.22l3-7.12c.11-.25.17-.52.17-.8V10c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66L16 2h-2zM4 20H2V9h2v11z"/></svg>
                        <% } %>
                    </a>
                    <!-- Comment toggle -->
                    <button type="button"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm text-slate-400 hover:bg-slate-700 transition comment-toggle"
                        data-target="add-<%= post._id %>">
                        <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
                        <span>Comment</span>
                    </button>
                </div>

                <!-- Add comment form -->
                <div class="add-comment hidden mb-4" id="add-<%= post._id %>">
                    <form action="/comment/<%= post._id %>" method="post" class="flex gap-2">
                        <input name="content" placeholder="Add a comment…"
                            class="flex-1 px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-sm outline-none focus:border-indigo-500 text-slate-100" required />
                        <button type="submit"
                            class="px-4 py-2 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-sm font-medium text-white transition">
                            Post
                        </button>
                    </form>
                </div>

                <!-- Comments section -->
                <% if (topCount > 0) { %>
                <div class="border-t border-slate-700/50 pt-3">
                    <button type="button"
                        class="show-top-comments mb-3 text-xs font-medium text-indigo-400 hover:text-indigo-300 transition"
                        data-panel="top-<%= post._id %>"
                        data-count="<%= topCount %>">
                        View <%= topCount %> comment<%= topCount === 1 ? '' : 's' %>
                    </button>

                    <div id="top-<%= post._id %>" class="top-comments-panel hidden" data-shown="0" data-page="20">
                        <%
                        function renderComment(c, depth) {
                            var isLiked = likedByMe(c.likes, currentUserId);
                            var likeCount = (c.likes && c.likes.length) ? c.likes.length : 0;
                            var replies = childCount(post.comments, c._id);
                            var cname = c.user && c.user.username ? c.user.username : 'unknown';
                            var isCommentOwner = c.user && c.user._id.toString() === currentUserId.toString();
                            var isPostOwner = post.user && post.user._id.toString() === currentUserId.toString();
                        %>
                        <div class="comment comment-item hidden mb-4" style="margin-left: <%= depth * 24 %>px">
                            <div class="flex gap-2">
                                <div class="w-7 h-7 rounded-full bg-slate-600 flex-shrink-0 flex items-center justify-center text-xs font-bold text-slate-200">
                                    <%= cname.charAt(0).toUpperCase() %>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-baseline gap-2 mb-0.5">
                                        <span class="text-sm font-semibold text-white">@<%= cname %></span>
                                        <span class="text-xs text-slate-500"><%= timeAgo(c.date) %></span>
                                    </div>
                                    <p class="text-sm text-slate-300 leading-relaxed"><%= c.content %></p>
                                    <div class="flex flex-wrap items-center gap-3 mt-1.5 text-xs text-slate-500">
                                        <!-- Comment like (thumb up) -->
                                        <a href="/comment/<%= post._id %>/like/<%= c._id %>"
                                            class="inline-flex items-center gap-1 hover:text-indigo-400 transition <%= isLiked ? 'text-indigo-400' : '' %>">
                                            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 <%= isLiked ? 'fill-current' : 'fill-none stroke-current' %>" stroke-width="2">
                                                <path d="M14 2l-1.41 1.41L14.17 5H11c-1.1 0-1.99.9-1.99 2L9 18c0 1.1.89 2 1.99 2H18c.83 0 1.54-.5 1.84-1.22l3-7.12c.11-.25.17-.52.17-.8V10c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66L16 2h-2zM4 20H2V9h2v11z"/>
                                            </svg>
                                            <% if (likeCount > 0) { %><%= likeCount %><% } %>
                                        </a>
                                        <button type="button" class="hover:text-white reply-toggle" data-target="reply-<%= c._id %>">Reply</button>
                                        <% if (isCommentOwner) { %>
                                            <button type="button" class="edit-comment-btn hover:text-amber-400" data-post-id="<%= post._id %>" data-comment-id="<%= c._id %>">Edit</button>
                                            <form action="/comment/<%= post._id %>/delete/<%= c._id %>" method="post" class="inline">
                                                <button type="submit" class="hover:text-rose-400">Delete</button>
                                            </form>
                                        <% } else if (isPostOwner) { %>
                                            <form action="/comment/<%= post._id %>/delete/<%= c._id %>" method="post" class="inline">
                                                <button type="submit" class="hover:text-rose-400">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>

                                    <!-- Reply form -->
                                    <div class="add-comment hidden mt-2" id="reply-<%= c._id %>">
                                        <form action="/comment/<%= post._id %>" method="post" class="flex gap-2">
                                            <input type="hidden" name="parent" value="<%= c._id %>" />
                                            <input name="content" placeholder="Add a reply…"
                                                class="flex-1 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-sm outline-none focus:border-indigo-500 text-slate-100" required />
                                            <button type="submit" class="px-3 py-1.5 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-xs text-white">Reply</button>
                                        </form>
                                    </div>

                                    <% if (replies > 0) { %>
                                    <button type="button"
                                        class="view-replies mt-2 text-xs font-medium text-indigo-400 hover:text-indigo-300 transition"
                                        data-panel="replies-<%= c._id %>"
                                        data-count="<%= replies %>">
                                        View <%= replies %> <%= replies === 1 ? 'reply' : 'replies' %>
                                    </button>
                                    <div id="replies-<%= c._id %>" class="replies-panel hidden mt-2" data-shown="0" data-page="20">
                                        <%
                                        (post.comments || []).forEach(function(child) {
                                            var cp = child.parent ? child.parent.toString() : null;
                                            if (cp !== c._id.toString()) return;
                                            renderComment(child, depth + 1);
                                        });
                                        %>
                                        <button type="button" class="load-more-replies hidden mt-2 text-xs text-slate-400 hover:text-white" data-panel="replies-<%= c._id %>">
                                            Load more replies
                                        </button>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <%
                        }
                        (post.comments || []).forEach(function(c) {
                            if (c.parent) return;
                            renderComment(c, 0);
                        });
                        %>
                        <button type="button" class="load-more-comments hidden mt-2 text-xs text-slate-400 hover:text-white" data-panel="top-<%= post._id %>">
                            Load more comments
                        </button>
                    </div>
                </div>
                <% } %>
            </div>
            <% }) %>
        </div>
    </div>

    <script>
        const PAGE = 20;

        function revealBatch(panel) {
            const items = Array.from(panel.querySelectorAll(':scope > .comment-item'));
            let shown = parseInt(panel.dataset.shown || '0', 10);
            const page = parseInt(panel.dataset.page || PAGE, 10);
            const next = Math.min(shown + page, items.length);
            for (let i = shown; i < next; i++) items[i].classList.remove('hidden');
            panel.dataset.shown = String(next);
            const loadBtn = panel.querySelector(':scope > .load-more-comments, :scope > .load-more-replies');
            if (loadBtn) loadBtn.classList.toggle('hidden', next >= items.length);
        }

        document.querySelectorAll('.show-top-comments, .view-replies').forEach(btn => {
            btn.addEventListener('click', () => {
                const panel = document.getElementById(btn.getAttribute('data-panel'));
                if (!panel) return;
                const count = btn.getAttribute('data-count');
                const isComments = btn.classList.contains('show-top-comments');
                if (panel.classList.contains('hidden')) {
                    panel.classList.remove('hidden');
                    if (parseInt(panel.dataset.shown || '0', 10) === 0) revealBatch(panel);
                    btn.textContent = isComments ? 'Hide comments' : 'Hide replies';
                } else {
                    panel.classList.add('hidden');
                    btn.textContent = isComments
                        ? `View ${count} comment${count === '1' ? '' : 's'}`
                        : `View ${count} ${count === '1' ? 'reply' : 'replies'}`;
                }
            });
        });

        document.querySelectorAll('.load-more-comments, .load-more-replies').forEach(btn => {
            btn.addEventListener('click', () => {
                const panel = document.getElementById(btn.getAttribute('data-panel'));
                if (panel) revealBatch(panel);
            });
        });

        document.querySelectorAll('.comment-toggle, .reply-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const el = document.getElementById(btn.getAttribute('data-target'));
                if (el) el.classList.toggle('hidden');
            });
        });

        document.querySelectorAll('.edit-comment-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const postId = btn.getAttribute('data-post-id');
                const commentId = btn.getAttribute('data-comment-id');
                const commentEl = btn.closest('.comment');
                if (!commentEl) return;
                const contentP = commentEl.querySelector('p');
                const old = contentP ? contentP.textContent : '';
                const form = document.createElement('form');
                form.method = 'post';
                form.action = `/comment/${postId}/edit/${commentId}`;
                form.className = 'flex gap-2 mt-2';
                const input = document.createElement('input');
                input.name = 'content';
                input.value = old;
                input.className = 'flex-1 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100';
                const save = document.createElement('button');
                save.type = 'submit';
                save.className = 'px-3 py-1.5 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-xs text-white';
                save.textContent = 'Save';
                const cancel = document.createElement('button');
                cancel.type = 'button';
                cancel.className = 'px-3 py-1.5 bg-slate-700 hover:bg-slate-600 rounded-xl text-xs text-slate-300';
                cancel.textContent = 'Cancel';
                cancel.addEventListener('click', () => form.remove());
                form.append(input, save, cancel);
                commentEl.querySelector('.flex-1').appendChild(form);
            });
        });
    </script>
</body>
</html>
