<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile — PostHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0f172a] text-slate-100 min-h-screen">

    <!-- Nav -->
    <nav class="sticky top-0 z-30 bg-[#0f172a]/90 backdrop-blur border-b border-slate-800">
        <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
            <a href="/feed" class="font-bold text-lg tracking-tight flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-500 flex items-center justify-center text-white text-sm font-bold">P</span>
                PostHub
            </a>
            <div class="flex items-center gap-1 text-sm">
                <a href="/feed" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Feed</a>
                <a href="/profile" class="px-3 py-1.5 rounded-lg bg-slate-800 text-white font-medium">Profile</a>
                <a href="/logout" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Logout</a>
            </div>
        </div>
    </nav>

    <div class="max-w-2xl mx-auto px-4 py-8 flex flex-col gap-6">

        <!-- User info + create post -->
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-5">
                <div class="w-12 h-12 rounded-full bg-indigo-500 flex items-center justify-center text-white text-xl font-bold">
                    <%= user.username.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <p class="font-semibold text-white"><%= user.name %></p>
                    <p class="text-sm text-slate-400">@<%= user.username %></p>
                </div>
            </div>
            <label class="block text-xs text-slate-400 mb-1.5">Create a post</label>
            <form method="post" action="/post">
                <textarea name="content" placeholder="What's on your mind?" rows="3"
                    class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition resize-none placeholder-slate-600 mb-3"></textarea>
                <button type="submit"
                    class="px-5 py-2 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-sm font-semibold text-white transition">
                    Post
                </button>
            </form>
        </div>

        <!-- Your Posts -->
        <div>
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wide mb-3">Your Posts</h2>
            <% if (user.posts.length === 0) { %>
            <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-6 text-center text-slate-500 text-sm">
                No posts yet. Create one above!
            </div>
            <% } %>
            <div class="flex flex-col gap-3">
                <% user.posts.slice().reverse().forEach(function(post){ %>
                <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-5">
                    <p class="text-sm text-slate-200 leading-relaxed mb-3"><%= post.content %></p>
                    <div class="flex items-center gap-1 flex-wrap text-xs">
                        <span class="text-slate-500"><%= post.likes.length %> like<%= post.likes.length === 1 ? '' : 's' %></span>
                        <span class="text-slate-700 mx-1">·</span>
                        <a href="/like/<%= post._id %>" class="px-2.5 py-1 rounded-lg hover:bg-slate-700 text-slate-400 hover:text-white transition">
                            <%= post.likes.indexOf(user._id) === -1 ? 'Like' : 'Unlike' %>
                        </a>
                        <a href="/edit/<%= post._id %>" class="px-2.5 py-1 rounded-lg hover:bg-slate-700 text-slate-400 hover:text-white transition">Edit</a>
                        <form method="post" action="/delete/<%= post._id %>" class="inline" onsubmit="return confirm('Delete this post?');">
                            <button type="submit" class="px-2.5 py-1 rounded-lg hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 transition">Delete</button>
                        </form>
                        <button type="button" class="px-2.5 py-1 rounded-lg hover:bg-emerald-500/20 text-slate-400 hover:text-emerald-400 transition share-btn" data-post-id="<%= post._id %>">Share</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg hover:bg-purple-500/20 text-slate-400 hover:text-purple-400 transition collab-btn" data-post-id="<%= post._id %>">Collab</button>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Shared with You -->
        <% if (user.sharedPosts && user.sharedPosts.length > 0) { %>
        <div>
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wide mb-3">Shared with You</h2>
            <div class="flex flex-col gap-3">
                <% user.sharedPosts.slice().reverse().forEach(function(post){ %>
                <div class="bg-[#1e293b] border border-emerald-700/30 rounded-2xl p-5">
                    <p class="text-xs text-emerald-400 mb-2">Shared by <span class="font-medium">@<%= post.user && post.user.username ? post.user.username : 'unknown' %></span></p>
                    <p class="text-sm text-slate-200 leading-relaxed"><%= post.content %></p>
                    <p class="text-xs text-slate-500 mt-2"><%= post.likes.length %> like<%= post.likes.length === 1 ? '' : 's' %></p>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Collab Posts -->
        <% if (typeof collabPosts !== 'undefined' && collabPosts && collabPosts.length > 0) { %>
        <div>
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wide mb-3">Collab Posts</h2>
            <div class="flex flex-col gap-3">
                <% collabPosts.forEach(function(post){ %>
                <div class="bg-[#1e293b] border border-purple-700/30 rounded-2xl p-5">
                    <p class="text-xs text-purple-400 mb-2">Collab with <span class="font-medium">@<%= post.user && post.user.username ? post.user.username : 'unknown' %></span></p>
                    <p class="text-sm text-slate-200 leading-relaxed mb-3"><%= post.content %></p>
                    <div class="flex items-center gap-1 text-xs">
                        <a href="/edit/<%= post._id %>" class="px-2.5 py-1 rounded-lg hover:bg-slate-700 text-slate-400 hover:text-white transition">Edit</a>
                        <form method="post" action="/delete/<%= post._id %>" class="inline" onsubmit="return confirm('Delete this post?');">
                            <button type="submit" class="px-2.5 py-1 rounded-lg hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 transition">Delete</button>
                        </form>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Share Modal -->
    <div id="share-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
        <div class="bg-[#1e293b] border border-slate-700 rounded-2xl p-6 w-full max-w-sm max-h-[70vh] flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <h3 id="modal-title" class="text-base font-semibold">Share with...</h3>
                <button id="close-modal" class="text-slate-400 hover:text-white text-xl leading-none">&times;</button>
            </div>
            <input id="user-search" type="text" placeholder="Search users..."
                class="mb-3 px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500">
            <div id="user-list" class="overflow-y-auto flex-1 flex flex-col gap-1">
                <p class="text-slate-400 text-sm">Loading...</p>
            </div>
            <p id="share-status" class="mt-3 text-sm text-center hidden"></p>
        </div>
    </div>

    <script>
        let sharePostId = null;
        let shareMode = 'normal';
        let allUsers = [];

        async function openModal(postId, mode) {
            sharePostId = postId;
            shareMode = mode;
            document.getElementById('modal-title').textContent = mode === 'collab' ? 'Collab Share with...' : 'Share with...';
            document.getElementById('share-modal').classList.remove('hidden');
            document.getElementById('share-status').classList.add('hidden');
            document.getElementById('user-search').value = '';
            if (allUsers.length === 0) {
                const res = await fetch('/api/users');
                allUsers = await res.json();
            }
            renderUsers(allUsers);
        }

        document.querySelectorAll('.share-btn').forEach(btn =>
            btn.addEventListener('click', () => openModal(btn.getAttribute('data-post-id'), 'normal')));
        document.querySelectorAll('.collab-btn').forEach(btn =>
            btn.addEventListener('click', () => openModal(btn.getAttribute('data-post-id'), 'collab')));

        document.getElementById('close-modal').addEventListener('click', () =>
            document.getElementById('share-modal').classList.add('hidden'));
        document.getElementById('share-modal').addEventListener('click', function(e) {
            if (e.target === this) this.classList.add('hidden');
        });
        document.getElementById('user-search').addEventListener('input', function() {
            const q = this.value.toLowerCase();
            renderUsers(allUsers.filter(u => u.username.toLowerCase().includes(q) || u.name.toLowerCase().includes(q)));
        });

        function renderUsers(users) {
            const list = document.getElementById('user-list');
            if (!users.length) { list.innerHTML = '<p class="text-slate-400 text-sm">No users found.</p>'; return; }
            list.innerHTML = users.map(u => `
                <div class="flex items-center justify-between px-3 py-2 rounded-xl hover:bg-slate-800">
                    <div>
                        <p class="text-sm font-medium text-white">@${u.username}</p>
                        <p class="text-xs text-slate-400">${u.name}</p>
                    </div>
                    <button onclick="doShare('${u._id}')"
                        class="px-3 py-1 text-xs rounded-full text-white ${shareMode === 'collab' ? 'bg-purple-600 hover:bg-purple-500' : 'bg-indigo-600 hover:bg-indigo-500'}">
                        ${shareMode === 'collab' ? 'Collab' : 'Share'}
                    </button>
                </div>`).join('');
        }

        async function doShare(toUserId) {
            const status = document.getElementById('share-status');
            const url = shareMode === 'collab' ? `/collab-share/${sharePostId}` : `/share/${sharePostId}`;
            const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ toUserId }) });
            const data = await res.json();
            const msgs = { ALREADY_SHARED: 'Already shared.', ALREADY_COLLAB: 'Already a collaborator.', NOT_OWNER: 'Only the owner can collab share.' };
            status.className = 'mt-3 text-sm text-center ' + (data.ok ? 'text-emerald-400' : 'text-rose-400');
            status.textContent = data.ok
                ? (shareMode === 'collab' ? 'Collab access granted!' : 'Shared successfully!')
                : (msgs[data.reason] || 'Something went wrong.');
            status.classList.remove('hidden');
        }
    </script>
</body>
</html>
