<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-between items-center">
            <a class="bg-zinc-700 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/feed">All Posts</a>
            <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/logout">Logout</a>
        </div>
        <h3 class="text-3xl"><span class="font-light">Hello</span>, <%= user.name %></h3>
        <h5 class="mb-5">you can create a new post</h5>
        <form method="post" action="/post">
            <textarea placeholder="What's on your mind?" class="w-1/3 p-3 block outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md" name="content"></textarea>
            <input class="px-3 py-2 w-40 block bg-blue-500 rounded-md mt-2" type="submit" value="Create New Post">
        </form>

        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your Posts</h3>
            <div class="postcontainer mt-5">
                <% user.posts.slice().reverse().forEach(function(post){%>
                    <div class="post w-1/3 p-4 rounded-md border-[1px] mb-4 border-zinc-700">
                        <h4 class="text-blue-500 mb-2">@<%= user.username %></h4>
                        <p class="text-sm tracking-tight"><%= post.content %></p>
                        <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
                        <div class="btns flex gap-4 mt-1 items-center">
                            <a class="text-blue-500" href="/like/<%= post._id %>">
                                <%= post.likes.indexOf(user._id) === -1 ? "Like" : "UnLike" %>
                            </a>
                            <a class="text-zinc-400" href="/edit/<%= post._id %>">edit</a>
                            <form method="post" action="/delete/<%= post._id %>" class="inline" onsubmit="return confirm('Delete this post?');">
                                <button type="submit" class="text-red-500 hover:underline">delete</button>
                            </form>
                            <button type="button"
                                class="text-green-400 hover:underline share-btn"
                                data-post-id="<%= post._id %>">
                                Share
                            </button>
                        </div>
                    </div>
                <%}) %>
            </div>
        </div>

        <% if (user.sharedPosts && user.sharedPosts.length > 0) { %>
        <div class="shared-posts mt-16">
            <h3 class="text-zinc-400">Shared with You</h3>
            <div class="mt-5">
                <% user.sharedPosts.slice().reverse().forEach(function(post){ %>
                    <div class="w-1/3 p-4 rounded-md border border-dashed border-zinc-600 mb-4 bg-zinc-800/40">
                        <p class="text-xs text-zinc-500 mb-1">Shared post — originally by
                            <span class="text-blue-400">@<%= post.user && post.user.username ? post.user.username : 'unknown' %></span>
                        </p>
                        <p class="text-sm tracking-tight text-zinc-100"><%= post.content %></p>
                        <small class="mt-2 inline-block text-zinc-400"><%= post.likes.length %> likes</small>
                    </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Share Modal -->
        <div id="share-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center">
            <div class="bg-zinc-800 rounded-xl p-6 w-80 max-h-[70vh] flex flex-col">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-semibold">Share with...</h3>
                    <button id="close-modal" class="text-zinc-400 hover:text-white text-xl leading-none">&times;</button>
                </div>
                <input id="user-search" type="text" placeholder="Search users..."
                    class="mb-3 px-3 py-2 rounded-md bg-zinc-700 text-sm outline-none border border-zinc-600 focus:border-zinc-400">
                <div id="user-list" class="overflow-y-auto flex-1 flex flex-col gap-2">
                    <p class="text-zinc-400 text-sm">Loading...</p>
                </div>
                <p id="share-status" class="mt-3 text-sm text-center hidden"></p>
            </div>
        </div>
    </div>

    <script>
        let sharePostId = null;
        let allUsers = [];

        document.querySelectorAll('.share-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                sharePostId = btn.getAttribute('data-post-id');
                document.getElementById('share-modal').classList.remove('hidden');
                document.getElementById('share-status').classList.add('hidden');
                document.getElementById('user-search').value = '';
                if (allUsers.length === 0) {
                    const res = await fetch('/api/users');
                    allUsers = await res.json();
                }
                renderUsers(allUsers);
            });
        });

        document.getElementById('close-modal').addEventListener('click', () => {
            document.getElementById('share-modal').classList.add('hidden');
        });

        // Close modal on backdrop click
        document.getElementById('share-modal').addEventListener('click', function(e) {
            if (e.target === this) this.classList.add('hidden');
        });

        document.getElementById('user-search').addEventListener('input', function() {
            const q = this.value.toLowerCase();
            renderUsers(allUsers.filter(u =>
                u.username.toLowerCase().includes(q) || u.name.toLowerCase().includes(q)
            ));
        });

        function renderUsers(users) {
            const list = document.getElementById('user-list');
            if (users.length === 0) {
                list.innerHTML = '<p class="text-zinc-400 text-sm">No users found.</p>';
                return;
            }
            list.innerHTML = users.map(u => `
                <div class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-zinc-700">
                    <div>
                        <p class="text-sm font-medium">@${u.username}</p>
                        <p class="text-xs text-zinc-400">${u.name}</p>
                    </div>
                    <button onclick="doShare('${u._id}')"
                        class="px-3 py-1 text-xs bg-blue-600 hover:bg-blue-500 rounded-full">
                        Share
                    </button>
                </div>
            `).join('');
        }

        async function doShare(toUserId) {
            const status = document.getElementById('share-status');
            const res = await fetch(`/share/${sharePostId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ toUserId })
            });
            const data = await res.json();
            status.classList.remove('hidden', 'text-green-400', 'text-red-400');
            if (data.ok) {
                status.textContent = 'Post shared successfully!';
                status.classList.add('text-green-400');
            } else if (data.reason === 'ALREADY_SHARED') {
                status.textContent = 'Already shared with this user.';
                status.classList.add('text-red-400');
            } else {
                status.textContent = 'Something went wrong.';
                status.classList.add('text-red-400');
            }
            status.classList.remove('hidden');
        }
    </script>
</body>
</html>
