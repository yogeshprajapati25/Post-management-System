<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - PostHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-[#0f0f0f] text-white">
    <%- include('partials/nav', { activePage: 'profile' }) %>
    
    <div class="max-w-2xl mx-auto p-6 mt-6">
        <div class="card mb-6">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-16 h-16 rounded-full bg-[#3ea6ff] flex items-center justify-center text-2xl font-bold">
                    <%= user.username.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <h1 class="text-2xl font-bold"><%= user.name %></h1>
                    <p class="text-[#aaa]">@<%= user.username %> · <%= user.posts.length %> post<%= user.posts.length === 1 ? '' : 's' %></p>
                </div>
            </div>
            
            <h3 class="text-sm font-semibold text-[#aaa] mb-3 uppercase tracking-wide">Create New Post</h3>
            <form method="post" action="/post" enctype="multipart/form-data">
                <div class="field mb-3">
                    <label for="content">What's on your mind?</label>
                    <textarea id="content" name="content" rows="4" placeholder="Share your thoughts..." required></textarea>
                </div>
                <div class="field mb-4">
                    <label for="image">Attach Image (optional)</label>
                    <input id="image" type="file" name="image" accept="image/*" class="text-sm text-[#aaa]">
                    <p class="hint">Images up to 5MB</p>
                </div>
                <button type="submit" class="btn-primary">Create Post</button>
            </form>
        </div>

        <div class="posts">
            <h2 class="text-xl font-bold mb-4 text-[#aaa]">Your Posts</h2>
            <div class="flex flex-col gap-4">
                <% if (user.posts.length === 0) { %>
                    <div class="card text-center py-8 text-[#aaa]">
                        <p>You haven't created any posts yet.</p>
                    </div>
                <% } %>
                
                <% user.posts.reverse().forEach(function(post){ %>
                    <div class="post card">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-[#3ea6ff] flex items-center justify-center text-sm font-bold">
                                    <%= user.username.charAt(0).toUpperCase() %>
                                </div>
                                <div>
                                    <h4 class="font-medium">@<%= user.username %></h4>
                                    <p class="text-xs text-[#aaa]">
                                        <%= new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </p>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <a href="/edit/<%= post._id %>" class="px-3 py-1.5 text-sm rounded-full hover:bg-[#272727] text-[#aaa]">Edit</a>
                                <form method="post" action="/delete/<%= post._id %>" class="inline" onsubmit="return confirm('Delete this post?');">
                                    <button type="submit" class="px-3 py-1.5 text-sm rounded-full hover:bg-[#272727] text-red-400">Delete</button>
                                </form>
                            </div>
                        </div>
                        
                        <p class="text-sm tracking-tight mb-3 whitespace-pre-wrap"><%= post.content %></p>
                        
                        <% if (post.image) { %>
                            <img src="<%= post.image %>" alt="Post image" class="rounded-xl max-h-96 object-cover mb-3">
                        <% } %>
                        
                        <div class="flex gap-4 items-center text-sm">
                            <a href="/like/<%= post._id %>" class="text-[#aaa] hover:text-white">
                                <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %> · <%= post.likes.length %>
                            </a>
                            <% if (post.comments && post.comments.length > 0) { %>
                                <span class="text-[#aaa]"><%= post.comments.length %> comment<%= post.comments.length === 1 ? '' : 's' %></span>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html>