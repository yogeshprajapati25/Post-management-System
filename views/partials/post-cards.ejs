<% function timeAgo(d){if(!d)return'';var s=Math.floor((Date.now()-new Date(d).getTime())/1000);if(s<60)return'just now';var m=Math.floor(s/60);if(m<60)return m+' minute'+(m===1?'':'s')+' ago';var h=Math.floor(m/60);if(h<24)return h+' hour'+(h===1?'':'s')+' ago';var dy=Math.floor(h/24);if(dy<30)return dy+' day'+(dy===1?'':'s')+' ago';var mo=Math.floor(dy/30);if(mo<12)return mo+' month'+(mo===1?'':'s')+' ago';var y=Math.floor(mo/12);return y+' year'+(y===1?'':'s')+' ago';}function likedByMe(arr,uid){return(arr||[]).some(function(id){return id.toString()===uid.toString();});}function childCount(comments,parentId){var pid=parentId?parentId.toString():null;return(comments||[]).filter(function(c){var p=c.parent?c.parent.toString():null;return p===pid;}).length;} %><% posts.forEach(function(post){var topCount=childCount(post.comments,null);var pLiked=likedByMe(post.likes,currentUserId);var pDisliked=likedByMe(post.dislikes,currentUserId);var pLikes=(post.likes||[]).length;var uname=post.user&&post.user.username?post.user.username:'unknown';%><div class="post card" data-reaction-root><div class="flex items-start justify-between mb-2"><div class="flex items-center gap-3"><div class="w-9 h-9 rounded-full bg-[#3ea6ff] text-black flex items-center justify-center text-sm font-semibold"><%= uname.charAt(0).toUpperCase() %></div><div><h4 class="text-[#aaa] font-medium">@<%= uname %></h4><span class="text-xs text-[#717171]"><%= timeAgo(post.date) %></span></div></div></div><% if(post.image){%><div class="mb-3 rounded-xl overflow-hidden"><img src="<%= post.image %>" class="w-full h-auto" alt="Post image"/></div><%}%><p class="text-sm tracking-tight mb-2 whitespace-pre-wrap md-body" data-md="<%= post.content %>"></p><div class="flex gap-3 items-center text-sm text-[#aaa] mb-4"><a href="/like/<%= post._id %>?from=feed" data-react-url="/like/<%= post._id %>?from=feed" data-react="like" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full hover:bg-[#272727] <%= pLiked ? 'active-like text-white' : '' %>" title="Like"><svg viewBox="0 0 24 24" class="w-5 h-5 <%= pLiked ? 'fill-current' : 'fill-none stroke-current' %>" stroke-width="1.6"><path d="M18.77,11h-4.23l1.52-4.94C16.38,5.03,15.55,4,14.63,4c-0.41,0-0.81,0.2-1.07,0.53L7,11H3v10h4h1h9.43 c1.06,0,1.98-0.67,2.19-1.61l1.34-6C21.23,12.15,20.18,11,18.77,11z M7,20H4v-8h3V20z"/></svg><span data-react-count="like"><%= pLikes>0?pLikes:'' %></span></a><a href="/dislike/<%= post._id %>?from=feed" data-react-url="/dislike/<%= post._id %>?from=feed" data-react="dislike" class="inline-flex items-center px-3 py-1 rounded-full hover:bg-[#272727] <%= pDisliked ? 'active-dislike text-white' : '' %>" title="Dislike"><svg viewBox="0 0 24 24" class="w-5 h-5 rotate-180 <%= pDisliked ? 'fill-current' : 'fill-none stroke-current' %>" stroke-width="1.6"><path d="M18.77,11h-4.23l1.52-4.94C16.38,5.03,15.55,4,14.63,4c-0.41,0-0.81,0.2-1.07,0.53L7,11H3v10h4h1h9.43z"/></svg></a><button type="button" class="hover:text-white px-3 py-1 rounded-full hover:bg-[#272727] comment-toggle" data-target="add-<%= post._id %>">Comment</button></div><div class="comments border-t border-[#272727] pt-4"><div class="add-comment hidden mb-4" id="add-<%= post._id %>"><form action="/comment/<%= post._id %>?ajax=1" method="post" class="flex gap-3 items-start" data-ajax-comment><div class="w-10 h-10 rounded-full bg-[#3ea6ff] flex items-center justify-center text-sm font-bold flex-shrink-0">Y</div><div class="flex-1"><input name="content" placeholder="Add a comment..." class="w-full bg-transparent border-b border-[#717171] pb-1 text-sm outline-none focus:border-white" required/><div class="flex justify-end gap-2 mt-2"><button type="submit" class="px-4 py-1.5 bg-[#3ea6ff] text-black rounded-full text-sm font-medium">Comment</button></div></div></form></div><% if(topCount>0){%><button type="button" class="show-top-comments mb-4 text-sm font-medium text-[#3ea6ff] hover:text-[#65b8ff]" data-panel="top-<%= post._id %>" data-count="<%= topCount %>"><%= topCount %> Comment<%= topCount===1?'':'s' %></button><div id="top-<%= post._id %>" class="top-comments-panel hidden" data-shown="0" data-page="20"><% function renderComment(c,depth){var isLiked=likedByMe(c.likes,currentUserId);var isDisliked=likedByMe(c.dislikes,currentUserId);var likeCount=(c.likes&&c.likes.length)?c.likes.length:0;var replies=childCount(post.comments,c._id);var isOwner=c.user&&c.user._id.toString()===currentUserId.toString();var cname=c.user&&c.user.username?c.user.username:'unknown';%><div class="comment comment-item hidden mb-5 group" style="margin-left:<%= depth*48 %>px"><div class="flex gap-3"><div class="w-10 h-10 rounded-full bg-[#606060] flex-shrink-0 flex items-center justify-center text-sm font-semibold"><%= cname.charAt(0).toUpperCase() %></div><div class="flex-1 min-w-0" data-reaction-root><div class="flex items-start justify-between gap-2"><div class="flex flex-wrap items-baseline gap-2"><span class="font-medium text-sm">@<%= cname %></span><span class="text-xs text-[#aaa]"><%= timeAgo(c.date) %></span></div><div class="relative flex-shrink-0"><button type="button" class="yt-dots w-8 h-8 rounded-full hover:bg-[#272727] flex items-center justify-center text-[#f1f1f1]" data-menu="menu-<%= c._id %>" aria-label="More actions"><svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M12 16.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5zm0-6c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5zm0-6c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5z"/></svg></button><div id="menu-<%= c._id %>" class="yt-menu absolute right-0 top-8 z-20 w-44 bg-[#282828] rounded-xl shadow-xl py-2 border border-[#3f3f3f]"><% if(isOwner){%><button type="button" class="edit-comment-btn w-full text-left px-4 py-2.5 text-sm hover:bg-[#3f3f3f] flex items-center gap-3" data-post-id="<%= post._id %>" data-comment-id="<%= c._id %>"><svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M14.06 7.6l2.34 2.34L7.5 18.84H5.16v-2.34L14.06 7.6zm3.48-3.48a.996.996 0 0 0-1.41 0l-1.83 1.83 2.34 2.34 1.83-1.83c.39-.39.39-1.02 0-1.41l-.93-.93z"/></svg> Edit</button><form action="/comment/<%= post._id %>/delete/<%= c._id %>?ajax=1" method="post" class="w-full"><button type="submit" class="w-full text-left px-4 py-2.5 text-sm hover:bg-[#3f3f3f] flex items-center gap-3" onclick="return confirm('Delete this comment?');"><svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg> Delete</button></form><%}else{%><button type="button" class="report-comment-btn w-full text-left px-4 py-2.5 text-sm hover:bg-[#3f3f3f] flex items-center gap-3"><svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M14.4 6 14 4H5v17h2v-7h5.6l.4 2h7V6z"/></svg> Report</button><%}%></div></div></div><p class="text-sm mt-1 leading-relaxed whitespace-pre-wrap" data-comment-body><%= c.content %></p><div class="flex flex-wrap items-center gap-1 mt-1.5 text-xs text-[#aaa]"><a href="/comment/<%= post._id %>/like/<%= c._id %>" data-react-url="/comment/<%= post._id %>/like/<%= c._id %>" data-react="like" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full hover:bg-[#272727] <%= isLiked?'text-white':'' %>" title="Like"><svg viewBox="0 0 24 24" class="w-[18px] h-[18px] <%= isLiked?'fill-current':'fill-none stroke-current' %>" stroke-width="1.6"><path d="M18.77,11h-4.23l1.52-4.94C16.38,5.03,15.55,4,14.63,4c-0.41,0-0.81,0.2-1.07,0.53L7,11H3v10h4h1h9.43z"/></svg><% if(likeCount>0){%><span data-react-count="like"><%= likeCount %></span><%}%></a><a href="/comment/<%= post._id %>/dislike/<%= c._id %>" data-react-url="/comment/<%= post._id %>/dislike/<%= c._id %>" data-react="dislike" class="inline-flex items-center px-2 py-1 rounded-full hover:bg-[#272727] <%= isDisliked?'text-white':'' %>" title="Dislike"><svg viewBox="0 0 24 24" class="w-[18px] h-[18px] rotate-180 <%= isDisliked?'fill-current':'fill-none stroke-current' %>" stroke-width="1.6"><path d="M18.77,11h-4.23l1.52-4.94C16.38,5.03,15.55,4,14.63,4c-0.41,0-0.81,0.2-1.07,0.53L7,11H3v10h4h1h9.43z"/></svg></a><button type="button" class="px-3 py-1 rounded-full font-medium uppercase tracking-wide hover:bg-[#272727] reply-toggle" data-target="reply-<%= c._id %>">Reply</button></div><div class="add-comment hidden mt-3" id="reply-<%= c._id %>"><form action="/comment/<%= post._id %>?ajax=1" method="post" class="flex gap-3"><input type="hidden" name="parent" value="<%= c._id %>"/><input name="content" placeholder="Add a reply..." class="flex-1 bg-transparent border-b border-[#717171] pb-1 text-sm outline-none focus:border-white" required/><button type="submit" class="px-3 py-1.5 bg-[#3ea6ff] text-black rounded-full text-sm font-medium">Reply</button></form></div><% if(replies>0){%><button type="button" class="view-replies mt-2 flex items-center gap-2 text-sm font-medium text-[#3ea6ff] hover:bg-[#263850] rounded-full px-3 py-1.5" data-panel="replies-<%= c._id %>" data-count="<%= replies %>"><svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M18 9.28l-6.35 6.35-6.37-6.35.72-.71 5.64 5.65 5.65-5.65z"/></svg> <%= replies %> <%= replies===1?'reply':'replies' %></button><div id="replies-<%= c._id %>" class="replies-panel hidden mt-2" data-shown="0" data-page="20"><% (post.comments||[]).forEach(function(child){var cp=child.parent?child.parent.toString():null;if(cp!==c._id.toString())return;renderComment(child,depth+1);});%><button type="button" class="load-more-replies hidden mt-2 text-sm font-medium text-[#3ea6ff] hover:text-[#65b8ff]" data-panel="replies-<%= c._id %>">Load more replies</button></div><%}%></div></div></div><%}(post.comments||[]).forEach(function(c){if(c.parent)return;renderComment(c,0);});%><button type="button" class="load-more-comments hidden mt-2 text-sm font-medium text-[#3ea6ff] hover:text-[#65b8ff]" data-panel="top-<%= post._id %>">Load more comments</button></div><%}%></div></div><%});%>