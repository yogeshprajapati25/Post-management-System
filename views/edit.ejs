<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post — PostHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0f172a] text-slate-100 min-h-screen">
    <nav class="sticky top-0 z-30 bg-[#0f172a]/90 backdrop-blur border-b border-slate-800">
        <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
            <a href="/feed" class="font-bold text-lg tracking-tight flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-500 flex items-center justify-center text-white text-sm font-bold">P</span>
                PostHub
            </a>
            <div class="flex items-center gap-1 text-sm">
                <a href="/feed" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Feed</a>
                <a href="/profile" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Profile</a>
                <a href="/logout" class="px-3 py-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white">Logout</a>
            </div>
        </div>
    </nav>

    <div class="max-w-2xl mx-auto px-4 py-8">
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-6">
            <h1 class="text-xl font-bold mb-5">Edit Post</h1>
            <form method="post" action="/update/<%= post._id %>">
                <div class="mb-5">
                    <label class="block text-xs text-slate-400 mb-1.5">Post Content</label>
                    <textarea name="content" rows="6" required
                        class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-slate-100 outline-none focus:border-indigo-500 transition resize-none"><%= post.content %></textarea>
                </div>
                <div class="flex gap-3">
                    <button type="submit"
                        class="px-5 py-2.5 bg-indigo-500 hover:bg-indigo-400 rounded-xl text-sm font-semibold text-white transition">
                        Save Changes
                    </button>
                    <a href="/profile"
                        class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 rounded-xl text-sm font-medium text-slate-300 transition">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
